#!/usr/bin/env bash
# Pangolin's detached client runs `sudo sh -c '...'` to create the TUN device.
# The bar has no TTY, so real sudo fails with "a terminal is required".
# Forward those calls to pkexec so Omarchy's polkit dialog can authorize them.
set -euo pipefail

while (( $# > 0 )); do
  case "$1" in
    -A|-n|-E|-H|-k|-K|-v|-b|-s|-l|-S)
      shift
      ;;
    -C|-g|-u|-U|-p|-r|-t|-i|--role|--prompt|--host|--chdir|--preserve-env)
      shift
      (( $# > 0 )) && shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      shift
      ;;
    *)
      break
      ;;
  esac
done

exec /usr/bin/pkexec \
  /usr/bin/env \
  HOME="${HOME:-}" \
  USER="${USER:-}" \
  LOGNAME="${LOGNAME:-${USER:-}}" \
  XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
  XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}" \
  DISPLAY="${DISPLAY:-}" \
  WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-}" \
  PANGOLIN_SUBPROCESS="${PANGOLIN_SUBPROCESS:-1}" \
  PANGOLIN_CREDENTIALS_FROM_KEYRING="${PANGOLIN_CREDENTIALS_FROM_KEYRING:-1}" \
  "$@"
